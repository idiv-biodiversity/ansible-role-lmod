{% if (lmod_canary == "opt-in") or (lmod_canary == "opt-in-skel") %}
if ( ! -e {{ __lmod_canary_opt_in_path }} ) then
  return
endif
{% elif lmod_canary == "opt-out" %}
if ( -e {{ __lmod_canary_opt_out_path }} ) then
  return
endif
{% endif %}

if ( ! $?__Init_Default_Modules )  then
  setenv __Init_Default_Modules 1
  if ( ! $?LMOD_SYSTEM_DEFAULT_MODULES ) then
    setenv LMOD_SYSTEM_DEFAULT_MODULES "StdEnv"
  endif
  module --initial_load restore
else
  module refresh
endif
